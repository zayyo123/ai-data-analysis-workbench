{
  "name": "ai-data-analysis-workbench",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "A Vue 3 AI data analysis workbench with CSV/Excel parsing, chart recommendations, dashboard editing, mock AI streaming analysis and report export.",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:fullstack": "playwright test --config playwright.fullstack.config.ts",
    "lint": "eslint src e2e *.config.* --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "echarts": "^5.6.0",
    "element-plus": "^2.10.7",
    "@element-plus/icons-vue": "^2.3.1",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "jspdf": "^2.5.2",
    "markdown-it": "^14.1.0",
    "papaparse": "^5.5.3",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.49.1",
    "@types/file-saver": "^2.0.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.7",
    "@types/papaparse": "^5.3.15",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
